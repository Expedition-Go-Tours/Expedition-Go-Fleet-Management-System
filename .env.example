# ─────────────────────────────────────────────────────────────────────────────
# Expedition Go Tours — Fleet Management System
# Copy to `.env.local` and fill in. Never commit real values.
# ─────────────────────────────────────────────────────────────────────────────

# ── Client (exposed to the browser via NEXT_PUBLIC_) ─────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Server only (Firebase Admin SDK — never expose) ──────────────────────────
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
# Keep newlines escaped as \n when pasting the service-account private key.
FIREBASE_ADMIN_PRIVATE_KEY=

# ── Document storage — Cloudinary (vehicle documents) ────────────────────────
# All three are required for uploads. Leave blank and the app degrades
# gracefully: document metadata still works, the upload button is disabled with
# a "not set up yet" note instead of failing. Create a free account at
# https://cloudinary.com and copy these from the Dashboard.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional: folder prefix for stored files (default: expedition-go/documents).
CLOUDINARY_FOLDER=

# ── Application secrets ──────────────────────────────────────────────────────
# 32+ random bytes, hex/base64. Peppers session-token hashes and cookie signing.
SESSION_SECRET=
# Bearer token that Vercel Cron sends to /api/v1/cron/*.
CRON_SECRET=
# MFA enforcement for privileged roles. Defaults to true (enforced); set
# "false" ONLY in development before TOTP is enabled in the Firebase console.
REQUIRE_MFA=true

# ── Routing & Maps ────────────────────────────────────────────────────────────
# Primary: Geoapify (free tier: 3,000 requests/day)
# https://my.geoapify.com/
GEOAPIFY_API_KEY=

# Secondary: Mapbox Directions API (server-side only, optional)
# https://account.mapbox.com/access-tokens/
MAPBOX_ACCESS_TOKEN=

# Map rendering: uses OpenFreeMap + MapLibre GL (free, no API key needed)
# No token required — tiles are served from https://tiles.openfreemap.org/