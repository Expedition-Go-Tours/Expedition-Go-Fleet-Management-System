# ─────────────────────────────────────────────────────────────────────────────
# Expedition Go Tours — Fleet Management System
# Copy to `.env.local` and fill in. Never commit real values.
# ─────────────────────────────────────────────────────────────────────────────

# ── Client (exposed to the browser via NEXT_PUBLIC_) ─────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Server only (Firebase Admin SDK — never expose) ──────────────────────────
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
# Keep newlines escaped as \n when pasting the service-account private key.
FIREBASE_ADMIN_PRIVATE_KEY=

# ── Object storage (Phase 3) — Cloudflare R2 (S3-compatible) ─────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=

# ── Application secrets ──────────────────────────────────────────────────────
# 32+ random bytes, hex/base64. Peppers session-token hashes and cookie signing.
SESSION_SECRET=
# Bearer token that Vercel Cron sends to /api/v1/cron/*.
CRON_SECRET=
# MFA enforcement for privileged roles. Defaults to true (enforced); set
# "false" ONLY in development before TOTP is enabled in the Firebase console.
REQUIRE_MFA=true
